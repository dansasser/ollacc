#!/usr/bin/env bash
# ollacc — Ollama Cloud Claude Code launcher
# Sources ~/.ollacc/config, prompts for key if missing, shows a top-10 model
# menu scraped from ollama.com/search?c=cloud (intersected with the user's
# auth'd cloud catalog), and launches `claude` with the chosen model.
#
# Heavy lifting lives in lib/. This file is the flow: handle flags →
# load config → ensure key → export SDK env → resolve catalog → render
# menu → maybe save default → exec claude.

set -u

# ---------- paths ----------
OLLACC_HOME="${OLLACC_HOME:-$HOME/.ollacc}"
OLLACC_CONFIG="$OLLACC_HOME/config"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# ---------- lib ----------
# shellcheck source=lib/config.sh
. "$SCRIPT_DIR/lib/config.sh"
# shellcheck source=lib/flags.sh
. "$SCRIPT_DIR/lib/flags.sh"
# shellcheck source=lib/auth.sh
. "$SCRIPT_DIR/lib/auth.sh"
# shellcheck source=lib/catalog.sh
. "$SCRIPT_DIR/lib/catalog.sh"
# shellcheck source=lib/menu.sh
. "$SCRIPT_DIR/lib/menu.sh"

# ---------- pre-flight: management flags exit early ----------
flags_handle "${1:-}" || true

# ---------- load config, ensure key, export SDK env ----------
auth_load_config
auth_prompt_if_missing
auth_export_sdk_env

# ---------- resolve the model list ----------
catalog_resolve

# ---------- default-model fast path ----------
MODEL=""
if [ -n "${OLLAMA_CLAUDE_DEFAULT_MODEL:-}" ] && [ "${1:-}" != "--model" ]; then
    local_fast_default="$OLLAMA_CLAUDE_DEFAULT_MODEL"
    if [[ "$authd_json" == *"\"name\":\"$local_fast_default\""* ]]; then
        echo "Using default: $local_fast_default"
        exec claude --model "$local_fast_default" "${@}"
    else
        echo "⚠️  Default model '$local_fast_default' is no longer in your cloud catalog. Showing menu…"
    fi
fi

# ---------- show menu, pick, maybe save ----------
menu_render
menu_choose
menu_offer_save_default

# ---------- launch ----------
echo ""
echo "🚀 Target Model: $MODEL"
echo "🔗 Connecting session..."
echo "---------------------------------------------"
exec claude --model "$MODEL" "$@"
